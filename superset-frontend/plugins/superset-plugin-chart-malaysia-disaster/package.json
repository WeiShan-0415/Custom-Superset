{
  "name": "superset-plugin-chart-malaysia-disaster",
  "version": "0.1.0",
  "description": "Pixel-matched Malaysia Disaster Watch iframe visualization for Apache Superset",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "files": ["esm", "lib"],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true});require('fs').rmSync('esm',{recursive:true,force:true})\"",
    "build:cjs": "babel src --extensions .ts,.tsx --out-dir lib --copy-files --source-maps --env-name cjs",
    "build:esm": "babel src --extensions .ts,.tsx --out-dir esm --copy-files --source-maps --env-name esm",
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "dev": "babel src --extensions .ts,.tsx --out-dir esm --copy-files --source-maps --env-name esm --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@apache-superset/core": "*",
    "@superset-ui/chart-controls": "*",
    "@superset-ui/core": "*",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/react": "^17.0.83",
    "@types/react-dom": "^17.0.26",
    "typescript": "5.4.5"
  }
}
